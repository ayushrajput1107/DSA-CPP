class Solution {
public:
    int find_next(vector<tuple<int, int, int>>& jobs, int i) {
        int target = get<1>(jobs[i]);
        int low = i + 1, high = jobs.size() - 1;
        int res = jobs.size();

        while (low <= high) {
            int mid = low + (high - low) / 2;
            int curr = get<0>(jobs[mid]);

            if (curr >= target) {
                res = mid;
                high = mid - 1;
            } else {
                low = mid + 1;
            }
        }

        return res;
    }

